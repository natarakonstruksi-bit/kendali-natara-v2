{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kendali-natara-v2",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/app-build.json",
      "/api/*",
      "/rest/*",
      "/storage/*",
      "/auth/*",
      "/info",
      "/public",
      "/informasi"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kendali-natara-db-v2",
      "database_id": "04849d77-cb23-4d50-9cfc-4e0d9c542d6b",
      "migrations_dir": "migrations"
    }
  ],
  // V3.4.19 — Cron untuk kirim ulang email notifikasi yang gagal/tertahan (setiap 5 menit).
  "triggers": { "crons": ["*/5 * * * *"] },
  // Konfigurasi notifikasi email (non-rahasia). Rahasia diisi lewat: npx wrangler secret put EMAIL_GAS_SECRET / EMAIL_API_KEY
  "vars": {
    "EMAIL_PROVIDER": "gas",
    "EMAIL_GAS_URL": "https://script.google.com/macros/s/AKfycbyu8pj7RSKlnmQ2JI8H-m3hdyNY0F2LUcqACty7ZoAV06UuXnQ4GI6V__M-3UjLscV_8A/exec",
    "EMAIL_FROM": "",
    "EMAIL_FROM_NAME": "Nara System — Natara Konstruksi",
    "APP_BASE_URL": "https://kendali-natara-v2.natarakonstruksi.workers.dev"
  },
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "kendali-natara-files-v2"
    }
  ]
}
