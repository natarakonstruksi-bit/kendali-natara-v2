{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kendali-natara-v2",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-08",

  "observability": {
    "enabled": true
  },

  // Frontend hasil `npm run build` (folder public/).
  // run_worker_first: path API/data/file selalu ditangani Worker lebih dulu,
  // sehingga tidak pernah tertukar dengan fallback SPA (index.html).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/rest/*", "/storage/*", "/auth/*", "/realtime/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kendali-natara-db-v2",
      "database_id": "04849d77-cb23-4d50-9cfc-4e0d9c542d6b",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "kendali-natara-files-v2"
    }
  ]

  // Opsional — verifikasi JWT Cloudflare Access secara ketat.
  // Isi lewat Dashboard > Workers & Pages > kendali-natara-v2 > Settings > Variables:
  //   ACCESS_TEAM_DOMAIN = <team>.cloudflareaccess.com
  //   ACCESS_AUD         = Application Audience (AUD) Tag dari Access application Worker ini
}
